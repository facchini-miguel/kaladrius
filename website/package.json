{
  "name": "kaladrius-docs",
  "version": "0.0.0",
  "private": true,
  "description": "Kaladrius documentation site (Docusaurus).",
  "scripts": {
    "manual": "node scripts/manual.mjs",
    "start": "npm run manual && docusaurus start",
    "start:pt-BR": "npm run manual && docusaurus start --locale pt-BR",
    "start:es": "npm run manual && docusaurus start --locale es",
    "build": "npm run manual && docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "prism-react-renderer": "2.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "engines": {
    "node": ">=20"
  }
}
