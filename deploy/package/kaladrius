#!/bin/bash
# The `kaladrius` command of the Linux package (.deb, .rpm and Arch Linux, decision 140):
# configures the installation (a few questions in text screens, or none with options, for
# technicians) and runs the everyday tasks. The rest is done by the server scripts beside it
# (common.sh, update.sh, backup.sh, health.sh, test_restore.sh), the same ones as on Google
# Cloud. Messages follow the server's language: Portuguese, Spanish or English. The command and
# option names of 0.54 and earlier (configurar, --acesso, rede-interna…) still work (decision 147).
set -euo pipefail
# A failed answer inside $(…) (a cancelled screen, the end of the input) stops the whole command.
shopt -s inherit_errexit

BIN=$(dirname "$(readlink -f "$0")")
# After an automatic rollback every command acts on the previous version (common.sh sets
# ON_PREVIOUS): restarting or starting the system never brings back the version that did not
# come up.
# shellcheck source=../server/common.sh
source "$BIN/common.sh"

case "${KALADRIUS_LANGUAGE:-${KALADRIUS_IDIOMA:-${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}}}" in
  pt*) UI_LANGUAGE=pt ;;
  es*) UI_LANGUAGE=es ;;
  *) UI_LANGUAGE=en ;;
esac

# The message in the server's language: t "português" "español" "English".
t() {
  case "$UI_LANGUAGE" in
    pt) printf '%s' "$1" ;;
    es) printf '%s' "$2" ;;
    *) printf '%s' "$3" ;;
  esac
}

ADMIN_CREATED="$DIR/admin-created"
TITLE="Kaladrius"
# The administrator's password for a setup with no questions (the old name still works).
ADMIN_PASSWORD=${KALADRIUS_ADMIN_PASSWORD:-${KALADRIUS_SENHA_ADMIN:-}}

fail() {
  echo "$(t "Erro" "Error" "Error"): $*" >&2
  exit 1
}

require_root() {
  [ "$(id -u)" -eq 0 ] || fail "$(t "rode com sudo: sudo kaladrius $*" "ejecute con sudo: sudo kaladrius $*" "run with sudo: sudo kaladrius $*")"
}

# --- Questions: text screens (whiptail) in a terminal, plain lines otherwise ----------------
# The screens and the prompts go to stderr, the terminal: the answers are read through $(…).

with_screens() {
  [ -z "${KALADRIUS_NO_SCREENS:-${KALADRIUS_SEM_TELAS:-}}" ] && command -v whiptail >/dev/null && [ -t 0 ] && [ -t 2 ]
}

# The screens' buttons in the server's language.
BUTTONS=(--ok-button "$(t "Avançar" "Siguiente" "Next")" --cancel-button "$(t "Cancelar" "Cancelar" "Cancel")")

# Text for a screen, wrapped to its width: whiptail sizes the box by the number of lines.
wrap() {
  printf '%s' "$1" | fold -s -w 66
}

notice() {  # notice "text"
  if with_screens; then
    whiptail --title "$TITLE" --ok-button "OK" --msgbox "$(wrap "$1")" 0 72 >&2
  else
    printf '\n%s\n\n' "$1" >&2
  fi
}

ask() {  # ask "question" "default": prints the answer
  local answer
  if with_screens; then
    answer=$(whiptail --title "$TITLE" "${BUTTONS[@]}" --inputbox "$(wrap "$1")" 0 72 "$2" 3>&1 1>&2 2>&3) || cancel
  else
    read -r -p "$1 [${2}] " answer || cancel
    answer=${answer:-$2}
  fi
  printf '%s' "$answer"
}

ask_password() {  # ask_password "question": prints the answer
  local answer text
  if with_screens; then
    # Its height given: sized by itself (0), whiptail's password box leaves the question out.
    text=$(wrap "$1")
    answer=$(whiptail --title "$TITLE" "${BUTTONS[@]}" --passwordbox "$text" \
      "$(($(printf '%s\n' "$text" | wc -l) + 7))" 72 3>&1 1>&2 2>&3) || cancel
  else
    # IFS= : spaces at the start or the end belong to the password.
    IFS= read -r -s -p "$1 " answer || cancel
    echo >&2
  fi
  printf '%s' "$answer"
}

choose() {  # choose "question" tag1 "text1" tag2 "text2"…: prints the chosen tag
  local question=$1 answer
  shift
  if with_screens; then
    answer=$(whiptail --title "$TITLE" "${BUTTONS[@]}" --notags --menu "$(wrap "$question")" 0 72 0 "$@" 3>&1 1>&2 2>&3) \
      || cancel
  else
    local -a tags=() i=1
    echo "$question" >&2
    while [ $# -gt 0 ]; do
      echo "  $i) $2" >&2
      tags+=("$1")
      shift 2
      i=$((i + 1))
    done
    while :; do
      read -r -p "> " answer || cancel
      if [[ "$answer" =~ ^[0-9]+$ ]] && [ "$answer" -ge 1 ] && [ "$answer" -le "${#tags[@]}" ]; then
        answer=${tags[$((answer - 1))]}
        break
      fi
    done
  fi
  printf '%s' "$answer"
}

# How to leave the questions: the screens' Cancel button, or Ctrl+C in plain text.
how_to_leave() {
  if with_screens; then t "Cancelar" "Cancelar" "Cancel"; else printf 'Ctrl+C'; fi
}

cancel() {
  echo >&2
  echo "$(t "Configuração interrompida. Para continuar: sudo kaladrius configure" "Configuración interrumpida. Para continuar: sudo kaladrius configure" "Setup interrupted. To go on: sudo kaladrius configure")" >&2
  exit 1
}

# --- Checks --------------------------------------------------------------------------------

# This server's address on the clinic's network: the one its traffic leaves from or, on a
# network with no way out (no default route), its first address that is not Docker's. Empty when
# there is none: never a failure, which would end `configure` before its question.
local_address() {
  local ip
  ip=$(ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p' | head -1 || true)
  [ -n "$ip" ] || ip=$(ip -4 -o addr show scope global 2>/dev/null \
    | awk '$2 !~ /^(docker|br-|veth)/ {sub(/\/.*/, "", $4); print $4; exit}' || true)
  printf '%s' "$ip"
}

is_ipv4() {
  local IFS=. octet
  [[ "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 1
  for octet in $1; do
    [ "$((10#$octet))" -le 255 ] || return 1
  done
}

is_domain() {
  [[ "$1" =~ ^([a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\.)+[a-zA-Z]{2,63}$ ]]
}

# Another program already listens on port 80 or 443 (Caddy needs both): Kaladrius's own Caddy
# is not one.
ports_taken() {
  service_running caddy && return 1
  ss -ltnH 2>/dev/null | awk '{print $4}' | grep -E ':(80|443)$' >/dev/null
}

# Caddy answers on ports 80 and 443 to the clinic's computers (and, with a domain, to the
# internet, for the certificate). A firewall that is on (firewalld: Fedora, Rocky, AlmaLinux,
# openSUSE; ufw: Ubuntu) gets them opened, or the system would answer only the server itself; one
# that is off is left alone.
open_ports() {
  if command -v firewall-cmd >/dev/null && firewall-cmd --state >/dev/null 2>&1; then
    if firewall-cmd --quiet --permanent --add-service=http --add-service=https \
      && firewall-cmd --quiet --reload; then
      echo "$(t "Firewall (firewalld): portas 80 e 443 abertas." "Firewall (firewalld): puertos 80 y 443 abiertos." "Firewall (firewalld): ports 80 and 443 opened.")"
    else
      notice "$(t "Não foi possível abrir as portas 80 e 443 no firewalld: abra-as à mão (sudo firewall-cmd --permanent --add-service=http --add-service=https && sudo firewall-cmd --reload)." "No fue posible abrir los puertos 80 y 443 en firewalld: ábralos a mano (sudo firewall-cmd --permanent --add-service=http --add-service=https && sudo firewall-cmd --reload)." "Ports 80 and 443 could not be opened in firewalld: open them by hand (sudo firewall-cmd --permanent --add-service=http --add-service=https && sudo firewall-cmd --reload).")"
    fi
  elif command -v ufw >/dev/null && ufw status 2>/dev/null | grep '^Status: active' >/dev/null; then
    if ufw allow 80/tcp >/dev/null && ufw allow 443/tcp >/dev/null; then
      echo "$(t "Firewall (ufw): portas 80 e 443 abertas." "Firewall (ufw): puertos 80 y 443 abiertos." "Firewall (ufw): ports 80 and 443 opened.")"
    else
      notice "$(t "Não foi possível abrir as portas 80 e 443 no ufw: abra-as à mão (sudo ufw allow 80/tcp && sudo ufw allow 443/tcp)." "No fue posible abrir los puertos 80 y 443 en ufw: ábralos a mano (sudo ufw allow 80/tcp && sudo ufw allow 443/tcp)." "Ports 80 and 443 could not be opened in ufw: open them by hand (sudo ufw allow 80/tcp && sudo ufw allow 443/tcp).")"
    fi
  fi
}

docker_ready() {
  command -v docker >/dev/null || fail "$(t "o Docker não está instalado." "Docker no está instalado." "Docker is not installed.")"
  systemctl enable --now docker >/dev/null 2>&1 || true
  docker compose version >/dev/null 2>&1 \
    || fail "$(t "falta o Docker Compose (docker compose)." "falta Docker Compose (docker compose)." "Docker Compose (docker compose) is missing.")"
  # Installed but not running: often a kernel installed with Docker and not booted yet (its
  # network modules are only in the new kernel), which only a restart of the server fixes.
  docker info >/dev/null 2>&1 \
    || fail "$(t "o Docker está instalado mas não está rodando (veja: sudo systemctl status docker). Se a instalação trouxe um kernel novo, reinicie o servidor e rode de novo: sudo kaladrius configure" "Docker está instalado pero no está en marcha (vea: sudo systemctl status docker). Si la instalación trajo un kernel nuevo, reinicie el servidor y ejecute de nuevo: sudo kaladrius configure" "Docker is installed but not running (see: sudo systemctl status docker). If the installation brought a new kernel, restart the server and run again: sudo kaladrius configure")"
}

# --- configure -----------------------------------------------------------------------------

configure_help() {
  cat <<EOF
$(t "Uso" "Uso" "Usage"): sudo kaladrius configure [--access internal-network|internet] [--address IP|DOMAIN]
                              [--user USER] [--email EMAIL]

$(t "Sem opções, pergunta tudo em telas. Com todas as opções e a senha em KALADRIUS_ADMIN_PASSWORD,
não pergunta nada (instalação por um técnico):" "Sin opciones, pregunta todo en pantallas. Con todas las opciones y la contraseña en
KALADRIUS_ADMIN_PASSWORD, no pregunta nada (instalación por un técnico):" "With no options it asks everything in screens. With every option and the password in
KALADRIUS_ADMIN_PASSWORD it asks nothing (installation by a technician):")

  read -rs KALADRIUS_ADMIN_PASSWORD && export KALADRIUS_ADMIN_PASSWORD
  sudo --preserve-env=KALADRIUS_ADMIN_PASSWORD kaladrius configure --access internal-network \\
    --address 192.168.0.10 --user admin
EOF
}

# A new .env, or the existing one with the address (and the administrator's user name and
# e-mail, which change until it is created) changed: the passwords and keys stay.
write_env() {
  local access=$1 address=$2 user=$3 email=$4 new
  new=$(mktemp "$DIR/.env.XXXXXX")
  if [ -f "$DIR/.env" ]; then
    grep -vE '^(KALADRIUS_ACCESS|KALADRIUS_ACESSO|SITE_HOSTNAME|DJANGO_ALLOWED_HOSTS|DJANGO_CSRF_TRUSTED_ORIGINS|DJANGO_ADMIN_USERNAME|DJANGO_ADMIN_EMAIL)=' \
      "$DIR/.env" >"$new"
  else
    cat >"$new" <<EOF
# Kaladrius: written by "kaladrius configure" on $(date -u +%Y-%m-%d). Never share this file:
# it holds the keys of the system. The administrator's password is not kept here.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=$(head -c 48 /dev/urandom | base64 | tr -d '\n/+=')
DJANGO_SECURE=1
DJANGO_REVERSE_PROXY=1
POSTGRES_DB=kaladrius
POSTGRES_USER=kaladrius
POSTGRES_PASSWORD=$(head -c 32 /dev/urandom | base64 | tr -d '\n/+=')
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Daily backup (06:00 UTC): this folder, keeping the last days. Copy it to another disk or
# computer: a backup on the same disk does not survive the disk.
KALADRIUS_BACKUP_DIR=$DEFAULT_BACKUP_DIR
KALADRIUS_BACKUP_DAYS=14
# Password recovery by e-mail (optional; empty: the administrator sets new passwords).
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USER=
DJANGO_EMAIL_PASSWORD=
DJANGO_EMAIL_FROM=
EOF
  fi
  cat >>"$new" <<EOF
DJANGO_ADMIN_USERNAME=$user
DJANGO_ADMIN_EMAIL=$email
KALADRIUS_ACCESS=$access
SITE_HOSTNAME=$address
DJANGO_ALLOWED_HOSTS=$address
DJANGO_CSRF_TRUSTED_ORIGINS=https://$address
EOF
  chmod 600 "$new"
  mv -f "$new" "$DIR/.env"
  ln -sfn ../.env "$DIR/release/.env"
}

# Creates the administrator with the password given; on a refusal (the system's password
# rules), prints the reasons and fails; exit status 3 when the user already exists. The password
# goes in the environment only; stdin is not handed to the container (it would read the answers
# still to come).
create_admin() {
  local user=$1 email=$2 password=$3 command=(create_admin --fail-if-exists)
  # The previous version, after a rollback, may know only the command's name before decision 148.
  compose exec -T app python manage.py help create_admin >/dev/null 2>&1 </dev/null \
    || command=(criar_admin --falhar-se-existir)
  DJANGO_ADMIN_USERNAME=$user DJANGO_ADMIN_EMAIL=$email DJANGO_ADMIN_PASSWORD=$password \
    compose exec -T -e DJANGO_ADMIN_USERNAME -e DJANGO_ADMIN_EMAIL -e DJANGO_ADMIN_PASSWORD \
    app python manage.py "${command[@]}" </dev/null 2>&1
}

# The password's rules are the system's own (create_admin), checked once it is running; the
# question only names the main ones.
ask_new_password() {
  local password confirmation
  while :; do
    password=$(ask_password "$(t "Senha do administrador (mínimo de 10 caracteres, não só números):" "Contraseña del administrador (mínimo 10 caracteres, no solo números):" "Administrator's password (at least 10 characters, not only digits):")")
    confirmation=$(ask_password "$(t "Digite a senha de novo:" "Escriba la contraseña de nuevo:" "Type the password again:")")
    [ "$password" = "$confirmation" ] && break
    notice "$(t "As senhas não conferem. Tente de novo." "Las contraseñas no coinciden. Inténtelo de nuevo." "The passwords do not match. Try again.")"
  done
  printf '%s' "$password"
}

configure() {
  local access="" address="" user="" email="" suggestion suggested_domain="" interactive=1 password="" output code reasons
  while [ $# -gt 0 ]; do
    case "$1" in
      --access | --acesso) access=${2:-}; shift 2 ;;
      --address | --endereco) address=${2:-}; shift 2 ;;
      --user | --usuario) user=${2:-}; shift 2 ;;
      --email) email=${2:-}; shift 2 ;;
      -h | --help) configure_help; return 0 ;;
      *) configure_help >&2; exit 2 ;;
    esac
  done
  # The access's value before decision 147.
  [ "$access" != rede-interna ] || access=internal-network
  require_root configure
  docker_ready
  # Everything given (the password in the environment): a technician's installation, no questions.
  if [ -n "$access" ] && [ -n "$address" ] && { [ -n "$user" ] || [ -f "$ADMIN_CREATED" ]; }; then
    interactive=""
  fi
  [ -n "$interactive" ] || [ -f "$ADMIN_CREATED" ] || [ -n "$ADMIN_PASSWORD" ] \
    || fail "$(t "sem perguntas, a senha do administrador vem em KALADRIUS_ADMIN_PASSWORD." "sin preguntas, la contraseña del administrador va en KALADRIUS_ADMIN_PASSWORD." "without questions, the administrator's password goes in KALADRIUS_ADMIN_PASSWORD.")"

  if [ -n "$interactive" ] && [ ! -f "$DIR/.env" ]; then
    notice "$(t "Bem-vindo ao Kaladrius.

Algumas perguntas para terminar a instalação: como a clínica vai acessar o sistema e o usuário administrador. Os dados da clínica você preenche depois, dentro do sistema." "Bienvenido a Kaladrius.

Algunas preguntas para terminar la instalación: cómo accederá la clínica al sistema y el usuario administrador. Los datos de la clínica se completan después, dentro del sistema." "Welcome to Kaladrius.

A few questions to finish the installation: how the clinic will reach the system, and the administrator user. You fill in the clinic's details later, inside the system.")"
  fi

  if [ -z "$access" ]; then
    access=$(choose "$(t "Como a clínica vai acessar o Kaladrius?" "¿Cómo accederá la clínica a Kaladrius?" "How will the clinic reach Kaladrius?")" \
      internal-network "$(t "Só na rede interna (sem domínio)" "Solo en la red interna (sin dominio)" "Internal network only (no domain)")" \
      internet "$(t "Pela internet, com domínio" "Por internet, con dominio" "Through the internet, with a domain")")
  fi
  case "$access" in
    internal-network | internet) ;;
    *) fail "--access: internal-network | internet" ;;
  esac

  while :; do
    if [ "$access" = internal-network ]; then
      if [ -z "$address" ]; then
        suggestion=$(env_value SITE_HOSTNAME)
        is_ipv4 "$suggestion" || suggestion=$(local_address)
        address=$(ask "$(t "Endereço IP deste servidor na rede da clínica. Ele deve ser fixo: reserve-o no roteador." "Dirección IP de este servidor en la red de la clínica. Debe ser fija: resérvela en el router." "This server's IP address on the clinic's network. It must not change: reserve it in the router.")" "$suggestion")
      fi
      is_ipv4 "$address" && break
      [ -n "$interactive" ] || fail "$(t "endereço IP inválido: $address" "dirección IP inválida: $address" "invalid IP address: $address")"
      notice "$(t "Endereço IP inválido: $address" "Dirección IP inválida: $address" "Invalid IP address: $address")"
    else
      if [ -z "$address" ]; then
        suggestion=${suggested_domain:-$(env_value SITE_HOSTNAME)}
        is_domain "$suggestion" || suggestion=""
        address=$(ask "$(t "Domínio do sistema (por exemplo clinica.exemplo.com.br). Ele já deve apontar para este servidor, com as portas 80 e 443 abertas na internet, para o certificado HTTPS gratuito." "Dominio del sistema (por ejemplo clinica.ejemplo.com). Ya debe apuntar a este servidor, con los puertos 80 y 443 abiertos a internet, para el certificado HTTPS gratuito." "The system's domain (for example clinic.example.com). It must already point to this server, with ports 80 and 443 open to the internet, for the free HTTPS certificate.")" "$suggestion")
        address=$(printf '%s' "$address" | tr '[:upper:]' '[:lower:]')
      fi
      # Without the domain in DNS the HTTPS certificate is not issued and the system never comes
      # up, so there is no going on without it.
      if is_domain "$address"; then
        getent ahosts "$address" >/dev/null && break
        [ -n "$interactive" ] || fail "$(t "o domínio $address não existe no DNS." "el dominio $address no existe en el DNS." "the domain $address does not exist in DNS.")"
        notice "$(t "O domínio $address ainda não existe no DNS, e sem isso o certificado HTTPS não sai. Crie no DNS o registro que aponta $address para este servidor e espere ele aparecer (pode levar alguns minutos), ou escolha outro domínio. Para sair: $(how_to_leave)." "El dominio $address aún no existe en el DNS, y sin eso el certificado HTTPS no se emite. Cree en el DNS el registro que apunta $address a este servidor y espere a que aparezca (puede tardar unos minutos), o elija otro dominio. Para salir: $(how_to_leave)." "The domain $address does not exist in DNS yet, and without it the HTTPS certificate is not issued. Create the DNS record pointing $address to this server and wait for it to appear (it may take a few minutes), or choose another domain. To leave: $(how_to_leave).")"
        suggested_domain=$address
      else
        [ -n "$interactive" ] || fail "$(t "domínio inválido: $address" "dominio inválido: $address" "invalid domain: $address")"
        notice "$(t "Domínio inválido: $address" "Dominio inválido: $address" "Invalid domain: $address")"
      fi
    fi
    address=""
  done

  if ports_taken; then
    fail "$(t "outro programa já usa a porta 80 ou 443 deste servidor (veja: sudo ss -ltnp). O Kaladrius precisa das duas." "otro programa ya usa el puerto 80 o 443 de este servidor (vea: sudo ss -ltnp). Kaladrius necesita los dos." "another program already uses port 80 or 443 of this server (see: sudo ss -ltnp). Kaladrius needs both.")"
  fi

  if [ -f "$ADMIN_CREATED" ]; then
    # The administrator exists: its user name and e-mail stay those in .env.
    user=$(env_value DJANGO_ADMIN_USERNAME)
    email=$(env_value DJANGO_ADMIN_EMAIL)
  else
    # Asked again after a run that did not finish: the answers given then are the defaults.
    suggestion=$(env_value DJANGO_ADMIN_USERNAME)
    [ -n "$user" ] || user=$(ask "$(t "Usuário do administrador (a conta de suporte da instalação):" "Usuario del administrador (la cuenta de soporte de la instalación):" "Administrator's user name (the installation's support account):")" "${suggestion:-admin}")
    [ -n "$email" ] || [ -z "$interactive" ] || email=$(ask "$(t "E-mail do administrador (opcional):" "Correo del administrador (opcional):" "Administrator's e-mail (optional):")" "$(env_value DJANGO_ADMIN_EMAIL)")
    if [ -n "$interactive" ] && [ -z "$ADMIN_PASSWORD" ]; then
      password=$(ask_new_password)
    else
      password=$ADMIN_PASSWORD
    fi
  fi

  write_env "$access" "$address" "$user" "$email"
  open_ports
  if [ -n "$ON_PREVIOUS" ]; then
    # After a rollback the refused version is not started again (installing the package again
    # tries it): the previous one restarts with the new .env (Compose recreates what it changes).
    echo "$(t "A versão ${PACKAGE_VERSION:-} não entrou no ar da última vez: o sistema reinicia na versão anterior..." "La versión ${PACKAGE_VERSION:-} no entró en marcha la última vez: el sistema se reinicia en la versión anterior..." "Version ${PACKAGE_VERSION:-} did not come up last time: the system restarts on the previous version...")"
    { compose up -d --remove-orphans </dev/null && reload_caddy && system_up; } \
      || fail "$(t "o sistema não respondeu. Veja os registros: sudo kaladrius logs" "el sistema no respondió. Vea los registros: sudo kaladrius logs" "the system did not answer. See the logs: sudo kaladrius logs")"
  else
    echo "$(t "Baixando e iniciando o sistema; na primeira vez leva alguns minutos..." "Descargando e iniciando el sistema; la primera vez tarda unos minutos..." "Downloading and starting the system; the first time takes a few minutes...")"
    "$BIN/update.sh" --force </dev/null \
      || fail "$(t "o sistema não respondeu. Veja os registros: sudo kaladrius logs" "el sistema no respondió. Vea los registros: sudo kaladrius logs" "the system did not answer. See the logs: sudo kaladrius logs")"
  fi

  while [ ! -f "$ADMIN_CREATED" ]; do
    output=$(create_admin "$user" "$email" "$password") && code=0 || code=$?
    if [ "$code" -eq 0 ]; then
      touch "$ADMIN_CREATED"
      break
    fi
    # The database kept from an earlier installation already has this user. Its password is not
    # changed behind the clinic's back: the installer says so, and how to change it.
    if [ "$code" -eq 3 ]; then
      touch "$ADMIN_CREATED"
      notice "$(t "O usuário $user já existe no banco de dados (de uma instalação anterior), e a senha dele não foi mudada: a senha digitada agora não vale. Para trocá-la: sudo kaladrius password $user" "El usuario $user ya existe en la base de datos (de una instalación anterior), y su contraseña no se cambió: la contraseña escrita ahora no vale. Para cambiarla: sudo kaladrius password $user" "User $user already exists in the database (from an earlier installation), and its password was not changed: the password typed now does not apply. To change it: sudo kaladrius password $user")"
      break
    fi
    # A refused password comes as the command's CommandError, with the reasons (its other lines
    # are the app's own log). Anything else (the container not answering, a database error) is
    # not the password's fault: asking for another one would never end.
    reasons=$(printf '%s\n' "$output" | sed -n 's/^CommandError: //p')
    if [ -z "$reasons" ]; then
      printf '%s\n' "$output" | tail -n 15 >&2
      fail "$(t "não foi possível criar o administrador (acima, o que o sistema respondeu). Tente de novo: sudo kaladrius configure" "no fue posible crear el administrador (arriba, lo que respondió el sistema). Inténtelo de nuevo: sudo kaladrius configure" "the administrator could not be created (above, what the system answered). Try again: sudo kaladrius configure")"
    fi
    [ -n "$interactive" ] || fail "$(t "o sistema recusou a senha:" "el sistema rechazó la contraseña:" "the system refused the password:") $reasons"
    notice "$(t "O sistema recusou a senha:" "El sistema rechazó la contraseña:" "The system refused the password:")

$reasons"
    password=$(ask_new_password)
  done
  finished
}

finished() {
  local address text
  address=$(env_value SITE_HOSTNAME)
  text="$(t "Kaladrius instalado e no ar." "Kaladrius instalado y en marcha." "Kaladrius is installed and running.")

$(t "Abra no navegador:" "Abra en el navegador:" "Open in the browser:")  https://$address"
  if internal_network; then
    text="$text

$(t "Na rede interna o certificado HTTPS é da própria instalação. Para o navegador confiar nele, instale nos computadores da clínica o arquivo gerado por:" "En la red interna el certificado HTTPS es de la propia instalación. Para que el navegador confíe en él, instale en las computadoras de la clínica el archivo generado por:" "On the internal network the HTTPS certificate belongs to the installation itself. For the browser to trust it, install on the clinic's computers the file made by:")
  sudo kaladrius certificate"
  fi
  text="$text

$(t "Backup diário em" "Copia de seguridad diaria en" "Daily backup in") $(backup_dir). $(t "Comandos:" "Comandos:" "Commands:") kaladrius help"
  if with_screens; then notice "$text"; fi
  printf '\n%s\n\n' "$text"
}

# --- Everyday commands ---------------------------------------------------------------------

require_configured() {
  [ -f "$DIR/.env" ] || fail "$(t "o Kaladrius ainda não foi configurado: sudo kaladrius configure" "Kaladrius aún no fue configurado: sudo kaladrius configure" "Kaladrius is not set up yet: sudo kaladrius configure")"
}

# Starting the system needs the setup finished: with no administrator yet nobody could log in.
# The other commands (logs, stop, status) still work, to see why `configure` stopped.
require_admin() {
  require_configured
  [ -f "$ADMIN_CREATED" ] || fail "$(t "a configuração não terminou (o administrador não foi criado). Para terminar: sudo kaladrius configure" "la configuración no terminó (el administrador no se creó). Para terminar: sudo kaladrius configure" "the setup did not finish (the administrator was not created). To finish it: sudo kaladrius configure")"
}

certificate() {
  local target=${1:-$PWD/kaladrius-certificate.crt}
  require_root certificate
  require_configured
  internal_network || fail "$(t "só a instalação na rede interna usa um certificado próprio." "solo la instalación en la red interna usa un certificado propio." "only the internal network installation uses a certificate of its own.")"
  local root_cert
  # Read first: a failure (Caddy stopped) never leaves an empty file to copy to the computers.
  # Docker's own error, if any, shows above the message.
  root_cert=$(compose exec -T caddy cat /data/caddy/pki/authorities/local/root.crt </dev/null) \
    && [ -n "$root_cert" ] \
    || fail "$(t "não foi possível ler o certificado do Caddy (acima, o motivo). Com o sistema parado: sudo kaladrius start, e tente de novo." "no fue posible leer el certificado de Caddy (arriba, el motivo). Con el sistema detenido: sudo kaladrius start, e inténtelo de nuevo." "the certificate could not be read from Caddy (above, why). With the system stopped: sudo kaladrius start, and try again.")"
  printf '%s\n' "$root_cert" >"$target"
  chmod 644 "$target"
  cat <<EOF
$(t "Certificado salvo em" "Certificado guardado en" "Certificate saved in"): $target

$(t "Copie-o (por exemplo num pen drive) para cada computador da clínica e instale-o:" "Cópielo (por ejemplo en un pendrive) a cada computadora de la clínica e instálelo:" "Copy it (on a USB stick, for example) to each of the clinic's computers and install it:")
  Windows: $(t "dois cliques no arquivo > Instalar certificado > Máquina local > Autoridades de Certificação Raiz Confiáveis" "doble clic en el archivo > Instalar certificado > Equipo local > Entidades de certificación raíz de confianza" "double-click the file > Install Certificate > Local Machine > Trusted Root Certification Authorities")
  macOS: $(t "dois cliques > Acesso às Chaves > Sistema; depois, no certificado, Confiar > Sempre" "doble clic > Acceso a Llaveros > Sistema; luego, en el certificado, Confiar > Siempre" "double-click > Keychain Access > System; then, on the certificate, Trust > Always Trust")
  Linux: sudo cp kaladrius-certificate.crt /usr/local/share/ca-certificates/ && sudo update-ca-certificates
  Firefox: $(t "Configurações > Privacidade e Segurança > Certificados > Importar" "Ajustes > Privacidad y seguridad > Certificados > Importar" "Settings > Privacy & Security > Certificates > Import")
EOF
}

status() {
  require_root status
  require_configured
  echo "Kaladrius ${PACKAGE_VERSION:-?}: https://$(env_value SITE_HOSTNAME)"
  local container running expected
  container=$(compose ps -q app 2>/dev/null | head -1 || true)
  running=$(docker inspect --format '{{.Image}}' "$container" 2>/dev/null || true)
  # The image this installation should run (the previous version's after a rollback), by id:
  # the same image may have several names.
  expected=$(docker image inspect --format '{{.Id}}' "$APP_IMAGE" 2>/dev/null || true)
  if ! docker info >/dev/null 2>&1; then
    echo "$(t "Atenção: o Docker não está rodando, e o sistema está fora do ar. Para ligá-lo: sudo systemctl enable --now docker; depois: sudo kaladrius start" "Atención: Docker no está en marcha, y el sistema está fuera de servicio. Para iniciarlo: sudo systemctl enable --now docker; después: sudo kaladrius start" "Warning: Docker is not running, and the system is down. To start it: sudo systemctl enable --now docker; then: sudo kaladrius start")"
    return 0
  elif [ ! -f "$ADMIN_CREATED" ]; then
    echo "$(t "Atenção: a configuração não terminou (o administrador não foi criado). Para terminar: sudo kaladrius configure" "Atención: la configuración no terminó (el administrador no se creó). Para terminar: sudo kaladrius configure" "Warning: the setup did not finish (the administrator was not created). To finish it: sudo kaladrius configure")"
  elif [ -z "$expected" ]; then
    echo "$(t "Atenção: a imagem da versão ${PACKAGE_VERSION:-} não está neste servidor (não foi possível baixá-la). Com a internet funcionando, instale o pacote de novo." "Atención: la imagen de la versión ${PACKAGE_VERSION:-} no está en este servidor (no se pudo descargar). Con internet funcionando, instale el paquete de nuevo." "Warning: the image of version ${PACKAGE_VERSION:-} is not on this server (it could not be downloaded). With the internet working, install the package again.")"
  elif [ -z "$container" ]; then
    echo "$(t "Atenção: o sistema está parado. Para iniciar: sudo kaladrius start" "Atención: el sistema está detenido. Para iniciarlo: sudo kaladrius start" "Warning: the system is stopped. To start it: sudo kaladrius start")"
  elif [ -n "$ON_PREVIOUS" ]; then
    echo "$(t "Atenção: a versão ${PACKAGE_VERSION:-} do pacote não entrou no ar e foi desfeita; o sistema segue na versão anterior. Veja o motivo em: sudo kaladrius logs app. Para tentar de novo, instale o pacote de novo." "Atención: la versión ${PACKAGE_VERSION:-} del paquete no entró en marcha y se deshizo; el sistema sigue en la versión anterior. Vea el motivo en: sudo kaladrius logs app. Para intentarlo de nuevo, instale el paquete de nuevo." "Warning: version ${PACKAGE_VERSION:-} of the package did not come up and was undone; the system stays on the previous version. See why in: sudo kaladrius logs app. To try again, install the package again.")"
  elif [ "$running" != "$expected" ]; then
    echo "$(t "Atenção: o sistema não roda a versão ${PACKAGE_VERSION:-} do pacote (ela não entrou no ar). Instale o pacote de novo ou veja: sudo kaladrius logs app" "Atención: el sistema no ejecuta la versión ${PACKAGE_VERSION:-} del paquete (no entró en marcha). Instale el paquete de nuevo o vea: sudo kaladrius logs app" "Warning: the system does not run version ${PACKAGE_VERSION:-} of the package (it did not come up). Install the package again or see: sudo kaladrius logs app")"
  fi
  compose ps
}

show_help() {
  cat <<EOF
Kaladrius ${PACKAGE_VERSION:-}

  sudo kaladrius configure         $(t "configura (ou muda o endereço de) a instalação" "configura (o cambia la dirección de) la instalación" "sets up the installation (or changes its address)")
  sudo kaladrius status            $(t "endereço e situação dos serviços" "dirección y estado de los servicios" "address and state of the services")
  sudo kaladrius health            $(t "processador, memória, disco, backups e tarefas" "procesador, memoria, disco, copias y tareas" "processor, memory, disk, backups and tasks")
  sudo kaladrius backup            $(t "faz um backup agora" "hace una copia de seguridad ahora" "makes a backup now")
  sudo kaladrius test-restore      $(t "restaura o último backup num banco descartável e confere" "restaura la última copia en una base descartable y verifica" "restores the latest backup into a throwaway database and checks it")
  sudo kaladrius certificate [FILE] $(t "o certificado para os computadores da rede interna" "el certificado para las computadoras de la red interna" "the certificate for the internal network's computers")
  sudo kaladrius password [USER]   $(t "troca a senha de um usuário" "cambia la contraseña de un usuario" "changes a user's password")
  sudo kaladrius logs [SERVICE]    $(t "registros (app, db, caddy); Ctrl+C para sair" "registros (app, db, caddy); Ctrl+C para salir" "logs (app, db, caddy); Ctrl+C to leave")
  sudo kaladrius restart           $(t "reinicia os serviços (e aplica mudanças do .env)" "reinicia los servicios (y aplica cambios del .env)" "restarts the services (and applies changes to .env)")
  sudo kaladrius stop | start      $(t "para ou inicia o sistema (os dados ficam)" "detiene o inicia el sistema (los datos quedan)" "stops or starts the system (the data stays)")

$(t "Atualizações: junto com as do sistema (sudo apt upgrade, sudo dnf upgrade ou sudo zypper update), pelo repositório de pacotes que o pacote adiciona ao ser instalado." "Actualizaciones: junto con las del sistema (sudo apt upgrade, sudo dnf upgrade o sudo zypper update), por el repositorio de paquetes que el paquete agrega al instalarse." "Updates: along with the system's (sudo apt upgrade, sudo dnf upgrade or sudo zypper update), through the package repository the package adds when installed.")
$(t "No Arch Linux e no CachyOS, ou sem o repositório: instale o pacote da versão nova por cima deste (sudo pacman -U kaladrius-….pkg.tar.zst, sudo apt install ./kaladrius_….deb ou sudo dnf install ./kaladrius-….rpm):" "En Arch Linux y CachyOS, o sin el repositorio: instale el paquete de la versión nueva sobre este (sudo pacman -U kaladrius-….pkg.tar.zst, sudo apt install ./kaladrius_….deb o sudo dnf install ./kaladrius-….rpm):" "On Arch Linux and CachyOS, or without the repository: install the new version's package over this one (sudo pacman -U kaladrius-….pkg.tar.zst, sudo apt install ./kaladrius_….deb or sudo dnf install ./kaladrius-….rpm):")
  https://github.com/facchini-miguel/kaladrius/releases
$(t "Documentação" "Documentación" "Documentation"): https://kaladrius-docs.facchini.eti.br
EOF
}

# The commands, each with its name of 0.54 and earlier, which still works (decision 147).
subcommand=${1:-help}
shift || true
case "$subcommand" in
  configure | configurar) configure "$@" ;;
  status | estado) status ;;
  health | saude) require_root health; require_configured; "$BIN/health.sh" ;;
  backup) require_root backup; require_configured; "$BIN/backup.sh" ;;
  test-restore | testar-restauracao) require_root test-restore; require_configured; "$BIN/test_restore.sh" ;;
  certificate | certificado) certificate "$@" ;;
  password | senha)
    require_root password
    require_configured
    compose exec app python manage.py changepassword "${1:-$(env_value DJANGO_ADMIN_USERNAME)}"
    ;;
  logs) require_root logs; require_configured; compose logs -f --tail 100 "$@" ;;
  # Recreated, not just restarted: a container reads .env only when it is created.
  restart | reiniciar) require_root restart; require_admin; compose up -d --force-recreate ;;
  stop | parar) require_root stop; require_configured; compose stop ;;
  start | iniciar) require_root start; require_admin; compose up -d ;;
  version | versao | --version) echo "${PACKAGE_VERSION:-?}" ;;
  help | ajuda | ayuda | -h | --help) show_help ;;
  *) show_help >&2; exit 2 ;;
esac
