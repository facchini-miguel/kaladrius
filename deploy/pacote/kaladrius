#!/bin/bash
# The `kaladrius` command of the Linux package (.deb and .rpm, decision 140): configures the
# installation (a few questions in text screens, or none with options, for technicians) and
# runs the everyday tasks. The rest is done by the server scripts beside it (comum.sh,
# atualizar.sh, backup.sh, saude.sh, testar_restauracao.sh), the same ones as on Google Cloud.
# Messages follow the server's language: Portuguese, Spanish or English.
set -euo pipefail
# A failed answer inside $(…) (a cancelled screen, the end of the input) stops the whole command.
shopt -s inherit_errexit

BIN=$(dirname "$(readlink -f "$0")")
# After an automatic rollback every command acts on the previous version (comum.sh sets
# NA_ANTERIOR): restarting or starting the system never brings back the version that did not
# come up.
# shellcheck source=../servidor/comum.sh
source "$BIN/comum.sh"

case "${KALADRIUS_IDIOMA:-${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}}" in
  pt*) IDIOMA=pt ;;
  es*) IDIOMA=es ;;
  *) IDIOMA=en ;;
esac

# The message in the server's language: t "português" "español" "English".
t() {
  case "$IDIOMA" in
    pt) printf '%s' "$1" ;;
    es) printf '%s' "$2" ;;
    *) printf '%s' "$3" ;;
  esac
}

ADMIN_CRIADO="$DIR/admin-criado"
TITULO="Kaladrius"

erro() {
  echo "$(t "Erro" "Error" "Error"): $*" >&2
  exit 1
}

exigir_root() {
  [ "$(id -u)" -eq 0 ] || erro "$(t "rode com sudo: sudo kaladrius $*" "ejecute con sudo: sudo kaladrius $*" "run with sudo: sudo kaladrius $*")"
}

# --- Questions: text screens (whiptail) in a terminal, plain lines otherwise ----------------
# The screens and the prompts go to stderr, the terminal: the answers are read through $(…).

com_telas() {
  [ -z "${KALADRIUS_SEM_TELAS:-}" ] && command -v whiptail >/dev/null && [ -t 0 ] && [ -t 2 ]
}

# The screens' buttons in the server's language.
BOTOES=(--ok-button "$(t "Avançar" "Siguiente" "Next")" --cancel-button "$(t "Cancelar" "Cancelar" "Cancel")")

# Text for a screen, wrapped to its width: whiptail sizes the box by the number of lines.
quebrar() {
  printf '%s' "$1" | fold -s -w 66
}

aviso() {  # aviso "text"
  if com_telas; then
    whiptail --title "$TITULO" --ok-button "OK" --msgbox "$(quebrar "$1")" 0 72 >&2
  else
    printf '\n%s\n\n' "$1" >&2
  fi
}

perguntar() {  # perguntar "question" "default": prints the answer
  local resposta
  if com_telas; then
    resposta=$(whiptail --title "$TITULO" "${BOTOES[@]}" --inputbox "$(quebrar "$1")" 0 72 "$2" 3>&1 1>&2 2>&3) || cancelar
  else
    read -r -p "$1 [${2}] " resposta || cancelar
    resposta=${resposta:-$2}
  fi
  printf '%s' "$resposta"
}

perguntar_senha() {  # perguntar_senha "question": prints the answer
  local resposta texto
  if com_telas; then
    # Its height given: sized by itself (0), whiptail's password box leaves the question out.
    texto=$(quebrar "$1")
    resposta=$(whiptail --title "$TITULO" "${BOTOES[@]}" --passwordbox "$texto" \
      "$(($(printf '%s\n' "$texto" | wc -l) + 7))" 72 3>&1 1>&2 2>&3) || cancelar
  else
    # IFS= : spaces at the start or the end belong to the password.
    IFS= read -r -s -p "$1 " resposta || cancelar
    echo >&2
  fi
  printf '%s' "$resposta"
}

escolher() {  # escolher "question" tag1 "text1" tag2 "text2"…: prints the chosen tag
  local pergunta=$1 resposta
  shift
  if com_telas; then
    resposta=$(whiptail --title "$TITULO" "${BOTOES[@]}" --notags --menu "$(quebrar "$pergunta")" 0 72 0 "$@" 3>&1 1>&2 2>&3) \
      || cancelar
  else
    local -a tags=() i=1
    echo "$pergunta" >&2
    while [ $# -gt 0 ]; do
      echo "  $i) $2" >&2
      tags+=("$1")
      shift 2
      i=$((i + 1))
    done
    while :; do
      read -r -p "> " resposta || cancelar
      if [[ "$resposta" =~ ^[0-9]+$ ]] && [ "$resposta" -ge 1 ] && [ "$resposta" -le "${#tags[@]}" ]; then
        resposta=${tags[$((resposta - 1))]}
        break
      fi
    done
  fi
  printf '%s' "$resposta"
}

# How to leave the questions: the screens' Cancel button, or Ctrl+C in plain text.
sair() {
  if com_telas; then t "Cancelar" "Cancelar" "Cancel"; else printf 'Ctrl+C'; fi
}

cancelar() {
  echo >&2
  echo "$(t "Configuração interrompida. Para continuar: sudo kaladrius configurar" "Configuración interrumpida. Para continuar: sudo kaladrius configurar" "Setup interrupted. To go on: sudo kaladrius configurar")" >&2
  exit 1
}

# --- Checks --------------------------------------------------------------------------------

# This server's address on the clinic's network: the one its traffic leaves from or, on a
# network with no way out (no default route), its first address that is not Docker's. Empty when
# there is none: never a failure, which would end `configurar` before its question.
endereco_local() {
  local ip
  ip=$(ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p' | head -1 || true)
  [ -n "$ip" ] || ip=$(ip -4 -o addr show scope global 2>/dev/null \
    | awk '$2 !~ /^(docker|br-|veth)/ {sub(/\/.*/, "", $4); print $4; exit}' || true)
  printf '%s' "$ip"
}

eh_ipv4() {
  local IFS=. octeto
  [[ "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 1
  for octeto in $1; do
    [ "$((10#$octeto))" -le 255 ] || return 1
  done
}

eh_dominio() {
  [[ "$1" =~ ^([a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\.)+[a-zA-Z]{2,63}$ ]]
}

# Another program already listens on port 80 or 443 (Caddy needs both): Kaladrius's own Caddy
# is not one.
portas_ocupadas() {
  servico_rodando caddy && return 1
  ss -ltnH 2>/dev/null | awk '{print $4}' | grep -E ':(80|443)$' >/dev/null
}

# Caddy answers on ports 80 and 443 to the clinic's computers (and, with a domain, to the
# internet, for the certificate). A firewall that is on (firewalld: Fedora, Rocky, AlmaLinux,
# openSUSE; ufw: Ubuntu) gets them opened, or the system would answer only the server itself; one
# that is off is left alone.
abrir_portas() {
  if command -v firewall-cmd >/dev/null && firewall-cmd --state >/dev/null 2>&1; then
    if firewall-cmd --quiet --permanent --add-service=http --add-service=https \
      && firewall-cmd --quiet --reload; then
      echo "$(t "Firewall (firewalld): portas 80 e 443 abertas." "Firewall (firewalld): puertos 80 y 443 abiertos." "Firewall (firewalld): ports 80 and 443 opened.")"
    else
      aviso "$(t "Não foi possível abrir as portas 80 e 443 no firewalld: abra-as à mão (sudo firewall-cmd --permanent --add-service=http --add-service=https && sudo firewall-cmd --reload)." "No fue posible abrir los puertos 80 y 443 en firewalld: ábralos a mano (sudo firewall-cmd --permanent --add-service=http --add-service=https && sudo firewall-cmd --reload)." "Ports 80 and 443 could not be opened in firewalld: open them by hand (sudo firewall-cmd --permanent --add-service=http --add-service=https && sudo firewall-cmd --reload).")"
    fi
  elif command -v ufw >/dev/null && ufw status 2>/dev/null | grep '^Status: active' >/dev/null; then
    if ufw allow 80/tcp >/dev/null && ufw allow 443/tcp >/dev/null; then
      echo "$(t "Firewall (ufw): portas 80 e 443 abertas." "Firewall (ufw): puertos 80 y 443 abiertos." "Firewall (ufw): ports 80 and 443 opened.")"
    else
      aviso "$(t "Não foi possível abrir as portas 80 e 443 no ufw: abra-as à mão (sudo ufw allow 80/tcp && sudo ufw allow 443/tcp)." "No fue posible abrir los puertos 80 y 443 en ufw: ábralos a mano (sudo ufw allow 80/tcp && sudo ufw allow 443/tcp)." "Ports 80 and 443 could not be opened in ufw: open them by hand (sudo ufw allow 80/tcp && sudo ufw allow 443/tcp).")"
    fi
  fi
}

docker_pronto() {
  command -v docker >/dev/null || erro "$(t "o Docker não está instalado." "Docker no está instalado." "Docker is not installed.")"
  systemctl enable --now docker >/dev/null 2>&1 || true
  docker compose version >/dev/null 2>&1 \
    || erro "$(t "falta o Docker Compose (docker compose)." "falta Docker Compose (docker compose)." "Docker Compose (docker compose) is missing.")"
  # Installed but not running: often a kernel installed with Docker and not booted yet (its
  # network modules are only in the new kernel), which only a restart of the server fixes.
  docker info >/dev/null 2>&1 \
    || erro "$(t "o Docker está instalado mas não está rodando (veja: sudo systemctl status docker). Se a instalação trouxe um kernel novo, reinicie o servidor e rode de novo: sudo kaladrius configurar" "Docker está instalado pero no está en marcha (vea: sudo systemctl status docker). Si la instalación trajo un kernel nuevo, reinicie el servidor y ejecute de nuevo: sudo kaladrius configurar" "Docker is installed but not running (see: sudo systemctl status docker). If the installation brought a new kernel, restart the server and run again: sudo kaladrius configurar")"
}

# --- configurar ----------------------------------------------------------------------------

ajuda_configurar() {
  cat <<EOF
$(t "Uso" "Uso" "Usage"): sudo kaladrius configurar [--acesso rede-interna|internet] [--endereco IP|DOMAIN]
                               [--usuario USER] [--email EMAIL]

$(t "Sem opções, pergunta tudo em telas. Com todas as opções e a senha em KALADRIUS_SENHA_ADMIN,
não pergunta nada (instalação por um técnico):" "Sin opciones, pregunta todo en pantallas. Con todas las opciones y la contraseña en
KALADRIUS_SENHA_ADMIN, no pregunta nada (instalación por un técnico):" "With no options it asks everything in screens. With every option and the password in
KALADRIUS_SENHA_ADMIN it asks nothing (installation by a technician):")

  read -rs KALADRIUS_SENHA_ADMIN && export KALADRIUS_SENHA_ADMIN
  sudo --preserve-env=KALADRIUS_SENHA_ADMIN kaladrius configurar --acesso rede-interna \\
    --endereco 192.168.0.10 --usuario admin
EOF
}

# A new .env, or the existing one with the address (and the administrator's user name and
# e-mail, which change until it is created) changed: the passwords and keys stay.
escrever_env() {
  local acesso=$1 endereco=$2 usuario=$3 email=$4 novo
  novo=$(mktemp "$DIR/.env.XXXXXX")
  if [ -f "$DIR/.env" ]; then
    grep -vE '^(KALADRIUS_ACESSO|SITE_HOSTNAME|DJANGO_ALLOWED_HOSTS|DJANGO_CSRF_TRUSTED_ORIGINS|DJANGO_ADMIN_USERNAME|DJANGO_ADMIN_EMAIL)=' \
      "$DIR/.env" >"$novo"
  else
    cat >"$novo" <<EOF
# Kaladrius: written by "kaladrius configurar" on $(date -u +%Y-%m-%d). Never share this file:
# it holds the keys of the system. The administrator's password is not kept here.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=$(head -c 48 /dev/urandom | base64 | tr -d '\n/+=')
DJANGO_SECURE=1
DJANGO_PROXY_REVERSO=1
POSTGRES_DB=kaladrius
POSTGRES_USER=kaladrius
POSTGRES_PASSWORD=$(head -c 32 /dev/urandom | base64 | tr -d '\n/+=')
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Daily backup (06:00 UTC): this folder, keeping the last days. Copy it to another disk or
# computer: a backup on the same disk does not survive the disk.
KALADRIUS_BACKUP_PASTA=$BACKUP_PASTA_PADRAO
KALADRIUS_BACKUP_DIAS=14
# Password recovery by e-mail (optional; empty: the administrator sets new passwords).
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USER=
DJANGO_EMAIL_PASSWORD=
DJANGO_EMAIL_FROM=
EOF
  fi
  cat >>"$novo" <<EOF
DJANGO_ADMIN_USERNAME=$usuario
DJANGO_ADMIN_EMAIL=$email
KALADRIUS_ACESSO=$acesso
SITE_HOSTNAME=$endereco
DJANGO_ALLOWED_HOSTS=$endereco
DJANGO_CSRF_TRUSTED_ORIGINS=https://$endereco
EOF
  chmod 600 "$novo"
  mv -f "$novo" "$DIR/.env"
  ln -sfn ../.env "$DIR/release/.env"
}

# Creates the administrator with the password given; on a refusal (the system's password
# rules), prints the reasons and fails; exit status 3 when the user already exists. The password
# goes in the environment only; stdin is not handed to the container (it would read the answers
# still to come).
criar_administrador() {
  local usuario=$1 email=$2 senha=$3
  DJANGO_ADMIN_USERNAME=$usuario DJANGO_ADMIN_EMAIL=$email DJANGO_ADMIN_PASSWORD=$senha \
    compose exec -T -e DJANGO_ADMIN_USERNAME -e DJANGO_ADMIN_EMAIL -e DJANGO_ADMIN_PASSWORD \
    app python manage.py criar_admin --falhar-se-existir </dev/null 2>&1
}

# The password's rules are the system's own (criar_admin), checked once it is running; the
# question only names the main ones.
pedir_senha() {
  local senha confirmacao
  while :; do
    senha=$(perguntar_senha "$(t "Senha do administrador (mínimo de 10 caracteres, não só números):" "Contraseña del administrador (mínimo 10 caracteres, no solo números):" "Administrator's password (at least 10 characters, not only digits):")")
    confirmacao=$(perguntar_senha "$(t "Digite a senha de novo:" "Escriba la contraseña de nuevo:" "Type the password again:")")
    [ "$senha" = "$confirmacao" ] && break
    aviso "$(t "As senhas não conferem. Tente de novo." "Las contraseñas no coinciden. Inténtelo de nuevo." "The passwords do not match. Try again.")"
  done
  printf '%s' "$senha"
}

configurar() {
  local acesso="" endereco="" usuario="" email="" sugestao sugestao_dominio="" interativo=1 senha="" saida codigo motivos
  while [ $# -gt 0 ]; do
    case "$1" in
      --acesso) acesso=${2:-}; shift 2 ;;
      --endereco) endereco=${2:-}; shift 2 ;;
      --usuario) usuario=${2:-}; shift 2 ;;
      --email) email=${2:-}; shift 2 ;;
      -h | --help) ajuda_configurar; return 0 ;;
      *) ajuda_configurar >&2; exit 2 ;;
    esac
  done
  exigir_root configurar
  docker_pronto
  # Everything given (the password in the environment): a technician's installation, no questions.
  if [ -n "$acesso" ] && [ -n "$endereco" ] && { [ -n "$usuario" ] || [ -f "$ADMIN_CRIADO" ]; }; then
    interativo=""
  fi
  [ -n "$interativo" ] || [ -f "$ADMIN_CRIADO" ] || [ -n "${KALADRIUS_SENHA_ADMIN:-}" ] \
    || erro "$(t "sem perguntas, a senha do administrador vem em KALADRIUS_SENHA_ADMIN." "sin preguntas, la contraseña del administrador va en KALADRIUS_SENHA_ADMIN." "without questions, the administrator's password goes in KALADRIUS_SENHA_ADMIN.")"

  if [ -n "$interativo" ] && [ ! -f "$DIR/.env" ]; then
    aviso "$(t "Bem-vindo ao Kaladrius.

Algumas perguntas para terminar a instalação: como a clínica vai acessar o sistema e o usuário administrador. Os dados da clínica você preenche depois, dentro do sistema." "Bienvenido a Kaladrius.

Algunas preguntas para terminar la instalación: cómo accederá la clínica al sistema y el usuario administrador. Los datos de la clínica se completan después, dentro del sistema." "Welcome to Kaladrius.

A few questions to finish the installation: how the clinic will reach the system, and the administrator user. You fill in the clinic's details later, inside the system.")"
  fi

  if [ -z "$acesso" ]; then
    acesso=$(escolher "$(t "Como a clínica vai acessar o Kaladrius?" "¿Cómo accederá la clínica a Kaladrius?" "How will the clinic reach Kaladrius?")" \
      rede-interna "$(t "Só na rede interna (sem domínio)" "Solo en la red interna (sin dominio)" "Internal network only (no domain)")" \
      internet "$(t "Pela internet, com domínio" "Por internet, con dominio" "Through the internet, with a domain")")
  fi
  case "$acesso" in
    rede-interna | internet) ;;
    *) erro "--acesso: rede-interna | internet" ;;
  esac

  while :; do
    if [ "$acesso" = rede-interna ]; then
      if [ -z "$endereco" ]; then
        sugestao=$(valor_do_env SITE_HOSTNAME)
        eh_ipv4 "$sugestao" || sugestao=$(endereco_local)
        endereco=$(perguntar "$(t "Endereço IP deste servidor na rede da clínica. Ele deve ser fixo: reserve-o no roteador." "Dirección IP de este servidor en la red de la clínica. Debe ser fija: resérvela en el router." "This server's IP address on the clinic's network. It must not change: reserve it in the router.")" "$sugestao")
      fi
      eh_ipv4 "$endereco" && break
      [ -n "$interativo" ] || erro "$(t "endereço IP inválido: $endereco" "dirección IP inválida: $endereco" "invalid IP address: $endereco")"
      aviso "$(t "Endereço IP inválido: $endereco" "Dirección IP inválida: $endereco" "Invalid IP address: $endereco")"
    else
      if [ -z "$endereco" ]; then
        sugestao=${sugestao_dominio:-$(valor_do_env SITE_HOSTNAME)}
        eh_dominio "$sugestao" || sugestao=""
        endereco=$(perguntar "$(t "Domínio do sistema (por exemplo clinica.exemplo.com.br). Ele já deve apontar para este servidor, com as portas 80 e 443 abertas na internet, para o certificado HTTPS gratuito." "Dominio del sistema (por ejemplo clinica.ejemplo.com). Ya debe apuntar a este servidor, con los puertos 80 y 443 abiertos a internet, para el certificado HTTPS gratuito." "The system's domain (for example clinic.example.com). It must already point to this server, with ports 80 and 443 open to the internet, for the free HTTPS certificate.")" "$sugestao")
        endereco=$(printf '%s' "$endereco" | tr '[:upper:]' '[:lower:]')
      fi
      # Without the domain in DNS the HTTPS certificate is not issued and the system never comes
      # up, so there is no going on without it.
      if eh_dominio "$endereco"; then
        getent ahosts "$endereco" >/dev/null && break
        [ -n "$interativo" ] || erro "$(t "o domínio $endereco não existe no DNS." "el dominio $endereco no existe en el DNS." "the domain $endereco does not exist in DNS.")"
        aviso "$(t "O domínio $endereco ainda não existe no DNS, e sem isso o certificado HTTPS não sai. Crie no DNS o registro que aponta $endereco para este servidor e espere ele aparecer (pode levar alguns minutos), ou escolha outro domínio. Para sair: $(sair)." "El dominio $endereco aún no existe en el DNS, y sin eso el certificado HTTPS no se emite. Cree en el DNS el registro que apunta $endereco a este servidor y espere a que aparezca (puede tardar unos minutos), o elija otro dominio. Para salir: $(sair)." "The domain $endereco does not exist in DNS yet, and without it the HTTPS certificate is not issued. Create the DNS record pointing $endereco to this server and wait for it to appear (it may take a few minutes), or choose another domain. To leave: $(sair).")"
        sugestao_dominio=$endereco
      else
        [ -n "$interativo" ] || erro "$(t "domínio inválido: $endereco" "dominio inválido: $endereco" "invalid domain: $endereco")"
        aviso "$(t "Domínio inválido: $endereco" "Dominio inválido: $endereco" "Invalid domain: $endereco")"
      fi
    fi
    endereco=""
  done

  if portas_ocupadas; then
    erro "$(t "outro programa já usa a porta 80 ou 443 deste servidor (veja: sudo ss -ltnp). O Kaladrius precisa das duas." "otro programa ya usa el puerto 80 o 443 de este servidor (vea: sudo ss -ltnp). Kaladrius necesita los dos." "another program already uses port 80 or 443 of this server (see: sudo ss -ltnp). Kaladrius needs both.")"
  fi

  if [ -f "$ADMIN_CRIADO" ]; then
    # The administrator exists: its user name and e-mail stay those in .env.
    usuario=$(valor_do_env DJANGO_ADMIN_USERNAME)
    email=$(valor_do_env DJANGO_ADMIN_EMAIL)
  else
    # Asked again after a run that did not finish: the answers given then are the defaults.
    sugestao=$(valor_do_env DJANGO_ADMIN_USERNAME)
    [ -n "$usuario" ] || usuario=$(perguntar "$(t "Usuário do administrador (a conta de suporte da instalação):" "Usuario del administrador (la cuenta de soporte de la instalación):" "Administrator's user name (the installation's support account):")" "${sugestao:-admin}")
    [ -n "$email" ] || [ -z "$interativo" ] || email=$(perguntar "$(t "E-mail do administrador (opcional):" "Correo del administrador (opcional):" "Administrator's e-mail (optional):")" "$(valor_do_env DJANGO_ADMIN_EMAIL)")
    if [ -n "$interativo" ] && [ -z "${KALADRIUS_SENHA_ADMIN:-}" ]; then
      senha=$(pedir_senha)
    else
      senha=${KALADRIUS_SENHA_ADMIN:-}
    fi
  fi

  escrever_env "$acesso" "$endereco" "$usuario" "$email"
  abrir_portas
  if [ -n "$NA_ANTERIOR" ]; then
    # After a rollback the refused version is not started again (installing the package again
    # tries it): the previous one restarts with the new .env (Compose recreates what it changes).
    echo "$(t "A versão ${VERSAO_DO_PACOTE:-} não entrou no ar da última vez: o sistema reinicia na versão anterior..." "La versión ${VERSAO_DO_PACOTE:-} no entró en marcha la última vez: el sistema se reinicia en la versión anterior..." "Version ${VERSAO_DO_PACOTE:-} did not come up last time: the system restarts on the previous version...")"
    { compose up -d --remove-orphans </dev/null && recarregar_caddy && sistema_no_ar; } \
      || erro "$(t "o sistema não respondeu. Veja os registros: sudo kaladrius logs" "el sistema no respondió. Vea los registros: sudo kaladrius logs" "the system did not answer. See the logs: sudo kaladrius logs")"
  else
    echo "$(t "Baixando e iniciando o sistema; na primeira vez leva alguns minutos..." "Descargando e iniciando el sistema; la primera vez tarda unos minutos..." "Downloading and starting the system; the first time takes a few minutes...")"
    "$BIN/atualizar.sh" --forcar </dev/null \
      || erro "$(t "o sistema não respondeu. Veja os registros: sudo kaladrius logs" "el sistema no respondió. Vea los registros: sudo kaladrius logs" "the system did not answer. See the logs: sudo kaladrius logs")"
  fi

  while [ ! -f "$ADMIN_CRIADO" ]; do
    saida=$(criar_administrador "$usuario" "$email" "$senha") && codigo=0 || codigo=$?
    if [ "$codigo" -eq 0 ]; then
      touch "$ADMIN_CRIADO"
      break
    fi
    # The database kept from an earlier installation already has this user. Its password is not
    # changed behind the clinic's back: the installer says so, and how to change it.
    if [ "$codigo" -eq 3 ]; then
      touch "$ADMIN_CRIADO"
      aviso "$(t "O usuário $usuario já existe no banco de dados (de uma instalação anterior), e a senha dele não foi mudada: a senha digitada agora não vale. Para trocá-la: sudo kaladrius senha $usuario" "El usuario $usuario ya existe en la base de datos (de una instalación anterior), y su contraseña no se cambió: la contraseña escrita ahora no vale. Para cambiarla: sudo kaladrius senha $usuario" "User $usuario already exists in the database (from an earlier installation), and its password was not changed: the password typed now does not apply. To change it: sudo kaladrius senha $usuario")"
      break
    fi
    # A refused password comes as the command's CommandError, with the reasons (its other lines
    # are the app's own log). Anything else (the container not answering, a database error) is
    # not the password's fault: asking for another one would never end.
    motivos=$(printf '%s\n' "$saida" | sed -n 's/^CommandError: //p')
    if [ -z "$motivos" ]; then
      printf '%s\n' "$saida" | tail -n 15 >&2
      erro "$(t "não foi possível criar o administrador (acima, o que o sistema respondeu). Tente de novo: sudo kaladrius configurar" "no fue posible crear el administrador (arriba, lo que respondió el sistema). Inténtelo de nuevo: sudo kaladrius configurar" "the administrator could not be created (above, what the system answered). Try again: sudo kaladrius configurar")"
    fi
    [ -n "$interativo" ] || erro "$(t "o sistema recusou a senha:" "el sistema rechazó la contraseña:" "the system refused the password:") $motivos"
    aviso "$(t "O sistema recusou a senha:" "El sistema rechazó la contraseña:" "The system refused the password:")

$motivos"
    senha=$(pedir_senha)
  done
  concluido
}

concluido() {
  local endereco texto
  endereco=$(valor_do_env SITE_HOSTNAME)
  texto="$(t "Kaladrius instalado e no ar." "Kaladrius instalado y en marcha." "Kaladrius is installed and running.")

$(t "Abra no navegador:" "Abra en el navegador:" "Open in the browser:")  https://$endereco"
  if rede_interna; then
    texto="$texto

$(t "Na rede interna o certificado HTTPS é da própria instalação. Para o navegador confiar nele, instale nos computadores da clínica o arquivo gerado por:" "En la red interna el certificado HTTPS es de la propia instalación. Para que el navegador confíe en él, instale en las computadoras de la clínica el archivo generado por:" "On the internal network the HTTPS certificate belongs to the installation itself. For the browser to trust it, install on the clinic's computers the file made by:")
  sudo kaladrius certificado"
  fi
  texto="$texto

$(t "Backup diário em" "Copia de seguridad diaria en" "Daily backup in") $(pasta_dos_backups). $(t "Comandos:" "Comandos:" "Commands:") kaladrius $(t ajuda ayuda help)"
  if com_telas; then aviso "$texto"; fi
  printf '\n%s\n\n' "$texto"
}

# --- Everyday commands ---------------------------------------------------------------------

exigir_configurado() {
  [ -f "$DIR/.env" ] || erro "$(t "o Kaladrius ainda não foi configurado: sudo kaladrius configurar" "Kaladrius aún no fue configurado: sudo kaladrius configurar" "Kaladrius is not set up yet: sudo kaladrius configurar")"
}

# Starting the system needs the setup finished: with no administrator yet nobody could log in.
# The other commands (logs, parar, estado) still work, to see why `configurar` stopped.
exigir_administrador() {
  exigir_configurado
  [ -f "$ADMIN_CRIADO" ] || erro "$(t "a configuração não terminou (o administrador não foi criado). Para terminar: sudo kaladrius configurar" "la configuración no terminó (el administrador no se creó). Para terminar: sudo kaladrius configurar" "the setup did not finish (the administrator was not created). To finish it: sudo kaladrius configurar")"
}

certificado() {
  local destino=${1:-$PWD/kaladrius-certificado.crt}
  exigir_root certificado
  exigir_configurado
  rede_interna || erro "$(t "só a instalação na rede interna usa um certificado próprio." "solo la instalación en la red interna usa un certificado propio." "only the internal network installation uses a certificate of its own.")"
  local raiz
  # Read first: a failure (Caddy stopped) never leaves an empty file to copy to the computers.
  # Docker's own error, if any, shows above the message.
  raiz=$(compose exec -T caddy cat /data/caddy/pki/authorities/local/root.crt </dev/null) \
    && [ -n "$raiz" ] \
    || erro "$(t "não foi possível ler o certificado do Caddy (acima, o motivo). Com o sistema parado: sudo kaladrius iniciar, e tente de novo." "no fue posible leer el certificado de Caddy (arriba, el motivo). Con el sistema detenido: sudo kaladrius iniciar, e inténtelo de nuevo." "the certificate could not be read from Caddy (above, why). With the system stopped: sudo kaladrius iniciar, and try again.")"
  printf '%s\n' "$raiz" >"$destino"
  chmod 644 "$destino"
  cat <<EOF
$(t "Certificado salvo em" "Certificado guardado en" "Certificate saved in"): $destino

$(t "Copie-o (por exemplo num pen drive) para cada computador da clínica e instale-o:" "Cópielo (por ejemplo en un pendrive) a cada computadora de la clínica e instálelo:" "Copy it (on a USB stick, for example) to each of the clinic's computers and install it:")
  Windows: $(t "dois cliques no arquivo > Instalar certificado > Máquina local > Autoridades de Certificação Raiz Confiáveis" "doble clic en el archivo > Instalar certificado > Equipo local > Entidades de certificación raíz de confianza" "double-click the file > Install Certificate > Local Machine > Trusted Root Certification Authorities")
  macOS: $(t "dois cliques > Acesso às Chaves > Sistema; depois, no certificado, Confiar > Sempre" "doble clic > Acceso a Llaveros > Sistema; luego, en el certificado, Confiar > Siempre" "double-click > Keychain Access > System; then, on the certificate, Trust > Always Trust")
  Linux: sudo cp kaladrius-certificado.crt /usr/local/share/ca-certificates/ && sudo update-ca-certificates
  Firefox: $(t "Configurações > Privacidade e Segurança > Certificados > Importar" "Ajustes > Privacidad y seguridad > Certificados > Importar" "Settings > Privacy & Security > Certificates > Import")
EOF
}

estado() {
  exigir_root estado
  exigir_configurado
  echo "Kaladrius ${VERSAO_DO_PACOTE:-?}: https://$(valor_do_env SITE_HOSTNAME)"
  local container rodando esperada
  container=$(compose ps -q app 2>/dev/null | head -1 || true)
  rodando=$(docker inspect --format '{{.Image}}' "$container" 2>/dev/null || true)
  # The image this installation should run (the previous version's after a rollback), by id:
  # the same image may have several names.
  esperada=$(docker image inspect --format '{{.Id}}' "$IMAGEM_APP" 2>/dev/null || true)
  if ! docker info >/dev/null 2>&1; then
    echo "$(t "Atenção: o Docker não está rodando, e o sistema está fora do ar. Para ligá-lo: sudo systemctl enable --now docker; depois: sudo kaladrius iniciar" "Atención: Docker no está en marcha, y el sistema está fuera de servicio. Para iniciarlo: sudo systemctl enable --now docker; después: sudo kaladrius iniciar" "Warning: Docker is not running, and the system is down. To start it: sudo systemctl enable --now docker; then: sudo kaladrius iniciar")"
    return 0
  elif [ ! -f "$ADMIN_CRIADO" ]; then
    echo "$(t "Atenção: a configuração não terminou (o administrador não foi criado). Para terminar: sudo kaladrius configurar" "Atención: la configuración no terminó (el administrador no se creó). Para terminar: sudo kaladrius configurar" "Warning: the setup did not finish (the administrator was not created). To finish it: sudo kaladrius configurar")"
  elif [ -z "$esperada" ]; then
    echo "$(t "Atenção: a imagem da versão ${VERSAO_DO_PACOTE:-} não está neste servidor (não foi possível baixá-la). Com a internet funcionando, instale o pacote de novo." "Atención: la imagen de la versión ${VERSAO_DO_PACOTE:-} no está en este servidor (no se pudo descargar). Con internet funcionando, instale el paquete de nuevo." "Warning: the image of version ${VERSAO_DO_PACOTE:-} is not on this server (it could not be downloaded). With the internet working, install the package again.")"
  elif [ -z "$container" ]; then
    echo "$(t "Atenção: o sistema está parado. Para iniciar: sudo kaladrius iniciar" "Atención: el sistema está detenido. Para iniciarlo: sudo kaladrius iniciar" "Warning: the system is stopped. To start it: sudo kaladrius iniciar")"
  elif [ -n "$NA_ANTERIOR" ]; then
    echo "$(t "Atenção: a versão ${VERSAO_DO_PACOTE:-} do pacote não entrou no ar e foi desfeita; o sistema segue na versão anterior. Veja o motivo em: sudo kaladrius logs app. Para tentar de novo, instale o pacote de novo." "Atención: la versión ${VERSAO_DO_PACOTE:-} del paquete no entró en marcha y se deshizo; el sistema sigue en la versión anterior. Vea el motivo en: sudo kaladrius logs app. Para intentarlo de nuevo, instale el paquete de nuevo." "Warning: version ${VERSAO_DO_PACOTE:-} of the package did not come up and was undone; the system stays on the previous version. See why in: sudo kaladrius logs app. To try again, install the package again.")"
  elif [ "$rodando" != "$esperada" ]; then
    echo "$(t "Atenção: o sistema não roda a versão ${VERSAO_DO_PACOTE:-} do pacote (ela não entrou no ar). Instale o pacote de novo ou veja: sudo kaladrius logs app" "Atención: el sistema no ejecuta la versión ${VERSAO_DO_PACOTE:-} del paquete (no entró en marcha). Instale el paquete de nuevo o vea: sudo kaladrius logs app" "Warning: the system does not run version ${VERSAO_DO_PACOTE:-} of the package (it did not come up). Install the package again or see: sudo kaladrius logs app")"
  fi
  compose ps
}

ajuda() {
  cat <<EOF
Kaladrius ${VERSAO_DO_PACOTE:-}

  sudo kaladrius configurar          $(t "configura (ou muda o endereço de) a instalação" "configura (o cambia la dirección de) la instalación" "sets up the installation (or changes its address)")
  sudo kaladrius estado              $(t "endereço e situação dos serviços" "dirección y estado de los servicios" "address and state of the services")
  sudo kaladrius saude               $(t "processador, memória, disco, backups e tarefas" "procesador, memoria, disco, copias y tareas" "processor, memory, disk, backups and tasks")
  sudo kaladrius backup              $(t "faz um backup agora" "hace una copia de seguridad ahora" "makes a backup now")
  sudo kaladrius testar-restauracao  $(t "restaura o último backup num banco descartável e confere" "restaura la última copia en una base descartable y verifica" "restores the latest backup into a throwaway database and checks it")
  sudo kaladrius certificado [ARQ]   $(t "o certificado para os computadores da rede interna" "el certificado para las computadoras de la red interna" "the certificate for the internal network's computers")
  sudo kaladrius senha [USUARIO]     $(t "troca a senha de um usuário" "cambia la contraseña de un usuario" "changes a user's password")
  sudo kaladrius logs [SERVICO]      $(t "registros (app, db, caddy); Ctrl+C para sair" "registros (app, db, caddy); Ctrl+C para salir" "logs (app, db, caddy); Ctrl+C to leave")
  sudo kaladrius reiniciar           $(t "reinicia os serviços (e aplica mudanças do .env)" "reinicia los servicios (y aplica cambios del .env)" "restarts the services (and applies changes to .env)")
  sudo kaladrius parar | iniciar     $(t "para ou inicia o sistema (os dados ficam)" "detiene o inicia el sistema (los datos quedan)" "stops or starts the system (the data stays)")

$(t "Atualizações: baixe o pacote da versão nova e instale-o por cima deste (sudo apt install ./kaladrius_….deb, sudo dnf install ./kaladrius-….rpm ou sudo pacman -U kaladrius-….pkg.tar.zst):" "Actualizaciones: descargue el paquete de la versión nueva e instálelo sobre este (sudo apt install ./kaladrius_….deb, sudo dnf install ./kaladrius-….rpm o sudo pacman -U kaladrius-….pkg.tar.zst):" "Updates: download the new version's package and install it over this one (sudo apt install ./kaladrius_….deb, sudo dnf install ./kaladrius-….rpm or sudo pacman -U kaladrius-….pkg.tar.zst):")
  https://github.com/facchini-miguel/kaladrius/releases
$(t "Documentação" "Documentación" "Documentation"): https://kaladrius-docs.facchini.eti.br
EOF
}

comando=${1:-ajuda}
shift || true
case "$comando" in
  configurar) configurar "$@" ;;
  estado) estado ;;
  saude) exigir_root saude; exigir_configurado; "$BIN/saude.sh" ;;
  backup) exigir_root backup; exigir_configurado; "$BIN/backup.sh" ;;
  testar-restauracao) exigir_root testar-restauracao; exigir_configurado; "$BIN/testar_restauracao.sh" ;;
  certificado) certificado "$@" ;;
  senha)
    exigir_root senha
    exigir_configurado
    compose exec app python manage.py changepassword "${1:-$(valor_do_env DJANGO_ADMIN_USERNAME)}"
    ;;
  logs) exigir_root logs; exigir_configurado; compose logs -f --tail 100 "$@" ;;
  # Recreated, not just restarted: a container reads .env only when it is created.
  reiniciar) exigir_root reiniciar; exigir_administrador; compose up -d --force-recreate ;;
  parar) exigir_root parar; exigir_configurado; compose stop ;;
  iniciar) exigir_root iniciar; exigir_administrador; compose up -d ;;
  versao | --version) echo "${VERSAO_DO_PACOTE:-?}" ;;
  ajuda | ayuda | help | -h | --help) ajuda ;;
  *) ajuda >&2; exit 2 ;;
esac
