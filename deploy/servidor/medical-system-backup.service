[Unit]
Description=Kaladrius: backup do banco no Cloud Storage
After=docker.service
# Up to 4 attempts in 3 hours; after that the unit stays failed and the web app warns.
StartLimitIntervalSec=3h
StartLimitBurst=4

[Service]
Type=oneshot
ExecStart=/opt/medical-system/bin/backup.sh
Restart=on-failure
RestartSec=20min
