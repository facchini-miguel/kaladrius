{
	servers {
		# A client sending a request very slowly cannot hold a connection forever.
		timeouts {
			read_header 10s
			read_body 60s
		}
	}
}

# HTTPS with an automatic Let's Encrypt certificate for SITE_HOSTNAME.
{$SITE_HOSTNAME} {
	encode zstd gzip
	# The largest legitimate upload is a medical record attachment (10 MB,
	# apps/prontuario/forms.py); a bank statement is up to 5 MB.
	request_body {
		max_size 11MB
	}
	reverse_proxy 127.0.0.1:8000 {
		# Ordinary form posts are read whole by Caddy before reaching the app, so a slow
		# client does not tie up one of its few workers.
		request_buffers 256KB
	}
	header -Server
}

# Documentation site (decision 067), when DOCS_HOSTNAME is set; otherwise this block answers
# only docs.localhost, with Caddy's local certificate, and never reaches the internet.
{$DOCS_HOSTNAME:docs.localhost} {
	encode zstd gzip
	# Public and indexed since the code was opened (decision 077).
	reverse_proxy 127.0.0.1:8080
	header -Server
}
