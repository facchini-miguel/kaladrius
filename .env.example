# Copie para .env e preencha. O .env nunca vai para o Git.
# Para gerar valores aleatórios: python3 -c "import secrets; print(secrets.token_urlsafe(50))"

DJANGO_DEBUG=1
DJANGO_SECRET_KEY=troque-por-um-valor-aleatorio
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Em produção (HTTPS): DJANGO_SECURE=1 e DJANGO_CSRF_TRUSTED_ORIGINS=https://seu-dominio
DJANGO_SECURE=0
DJANGO_CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=medical_system
POSTGRES_USER=medical_system
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Usuário administrador criado pelo comando "criar_admin"
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_EMAIL=
DJANGO_ADMIN_PASSWORD=troque-por-uma-senha-forte
