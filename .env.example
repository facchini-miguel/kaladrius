# Copy to .env and fill in. The .env file never goes into Git.
# To generate random values: python3 -c "import secrets; print(secrets.token_urlsafe(50))"

DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-to-a-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# In production (HTTPS): DJANGO_SECURE=1 and DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain
DJANGO_SECURE=0
DJANGO_CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=kaladrius
POSTGRES_USER=kaladrius
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Administrator user created by the "criar_admin" command
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_EMAIL=
DJANGO_ADMIN_PASSWORD=change-me-to-a-strong-password

# Password recovery by e-mail (optional; empty: the administrator sets new passwords).
# Gmail: smtp.gmail.com, port 587, the Gmail address and an app password.
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USER=
DJANGO_EMAIL_PASSWORD=
# DJANGO_EMAIL_SSL=1 for port 465
DJANGO_EMAIL_FROM=

# Password for the fake test users created by "popular_dados_teste" (development only)
DJANGO_SEED_PASSWORD=change-me-to-a-strong-password
