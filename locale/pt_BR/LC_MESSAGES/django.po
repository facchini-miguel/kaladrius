msgid "%(module)s needs: %(needs)s."
msgstr "%(module)s precisa de: %(needs)s."

msgid "Appointments start and end at multiples of this time."
msgstr "Os agendamentos começam e terminam em múltiplos deste tempo."

msgid "The schedule end must be after its start."
msgstr "O fim da agenda deve ser depois do início."

#, python-format
msgid ""
"The appointment on %(when)s would fall outside the new hours or slot "
"length. Adjust future appointments before changing the schedule."
msgstr ""
"O agendamento de %(when)s ficaria fora do novo horário ou do novo "
"intervalo. Ajuste os agendamentos futuros antes de mudar a agenda."

